{{- $pages := (where .Site.RegularPages "Section" "posts").ByDate.Reverse -}}
{{- $author := .Site.Params.author | default .Site.Title -}}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ .Site.Title | jsonify }},
  "home_page_url": {{ .Site.BaseURL | jsonify }},
  "feed_url": {{ with .OutputFormats.Get "json" }}{{ .Permalink | jsonify }}{{ else }}{{ "feed.json" | absURL | jsonify }}{{ end }},
  "description": {{ .Site.Params.description | jsonify }},
  "favicon": {{ "favicon.ico" | absURL | jsonify }},
  "expired": false,
  "authors": [
    {
      "name": {{ $author | jsonify }},
      "url": {{ .Site.BaseURL | jsonify }}
    }
  ],
  "items": [
    {{- range $index, $page := $pages }}
    {{- if $index }},{{ end }}
    {
      "id": {{ $page.Permalink | jsonify }},
      "title": {{ $page.Title | jsonify }},
      {{- with $page.Description }}
      "summary": {{ . | jsonify }},
      {{- end }}
      "content_html": {{ $page.Content | jsonify }},
      "url": {{ $page.Permalink | jsonify }},
      {{- with $page.Params.images }}
      "image": {{ (index . 0) | absURL | jsonify }},
      {{- end }}
      "date_published": {{ $page.Date.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
      "date_modified": {{ $page.Lastmod.Format "2006-01-02T15:04:05Z07:00" | jsonify }},
      "tags": {{ $page.Params.tags | default slice | jsonify }},
      "authors": [
        {
          "name": {{ $author | jsonify }},
          "url": {{ $.Site.BaseURL | jsonify }}
        }
      ]
    }
    {{- end }}
  ]
}
